<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spider_robot_ros2</name>
  <version>0.1.0</version>
  <description>ROS2 integration for UiA Spider Robot</description>
  <maintainer email="robotics@uia.no">UiA Robotics Team</maintainer>
  <license>MIT</license>

  <build_depend>rclpy</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>spider_robot</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>spider_robot</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>